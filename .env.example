# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# Dashboard: https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_publica_aqui

# Caminho base no GitHub Pages (nome do repositório)
VITE_BASE_PATH=/contrato-estetica/
